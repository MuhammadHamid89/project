<----------------->Props <------------------------>
Props (properties) are read-only arguments passed into React components like HTML attributes
 to dynamically share and pass data from a parent component to a child component.
 agr hum ny parent file my (app.jsx) my jo value di hain wo hum dosri file my (header.jsx, student.jsx)
 update ni kr skty agr change krna hain to hum state ka use kry gy.

 props follow one way data flows.

 ## props data type
 -- string
 -- boolean
 -- number
 -- array
 -- object
 -- function
 -- JSX

 -----> props simple example <----------
 file Name : student.jsx

 function Student(props){
    console.log('props',props)
    return(
        <>
        <h2>name:{props.name}</h2>
        <h2>age:{props.age}</h2>
        <h2>city:{props.city}</h2>

        </>
    )
}
export default Student

function Student({name,age,city}){
    // console.log('props',props)
    return(
        <>
        <h2>name:{name}</h2>
        <h2>age:{age}</h2>
        <h2>city:{city}</h2>

        </>
    )
}
export default Student
// example 2 : destaructure if have object data type data
function Student({name,age,city}){
    // console.log('props',props)
    return(
        <>
        <h2>name:{name}</h2>
        <h2>age:{age}</h2>
        <h2>city:{city}</h2>

        </>
    )
}
export default Student

///agr hum ek my name ni dey or dosry my hain osko kis trha likhna hain mgr app.jsx file my 
