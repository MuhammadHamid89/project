<--------------> child props <--------->
React automatically provide a special prop called children. it contain everything written between
the opening and closing tags of a components.

childprop : Card.jsx file:

//in this file practice child prop
function Card({children}){
    console.log('children',children)
    return(
        <>
        <h1 className="card">{children}</h1>
        </>
    )
}
export default  Card

App.jsx file:

import Card from "./Components/Cardchildprop"

function App(){
  // const name='ali'
  return(
    <>
   <Card>
    <h2>hello to main file</h2>
   </Card>
    </>
  )
}
export default App

